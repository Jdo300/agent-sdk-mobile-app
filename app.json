{
  "expo": {
    "name": "RG Agent Link",
    "slug": "bloop-agent-chat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "bloop",
      "letta-mobile"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resonancegroup.rglink",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Bloop connects directly to the local Milo server for chat and voice services.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "appleTeamId": "L6DX4VDCTF",
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8823C",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "package": "com.example.bloop",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach screenshots or photos to a message for your agent to look at."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFBFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110,
          "dark": {
            "backgroundColor": "#161618",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Local Milo to record voice messages.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "jdo300",
    "extra": {
      "eas": {
        "projectId": "b0f9e8c7-f68f-4041-9811-3edb65f9a0dc"
      }
    }
  }
}
